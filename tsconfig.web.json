{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/*"
      ],
      "@components/*": [
        "src/renderer/components/*"
      ],
      "@open-color/*": [
        "node_modules/open-color/*"
      ]
    },
    "noImplicitAny": true,
    "moduleResolution": "bundler"
  }
}
